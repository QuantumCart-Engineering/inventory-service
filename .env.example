# =========================
# MySQL Container (optional, for docker-compose)
# =========================

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=quantumcart_inventory
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST_PORT=3310


# =========================
# Inventory Service
# =========================

NODE_ENV=development
PORT=8005

# Database (required by app)
DB_HOST=localhost
DB_PORT=3310
DB_USER=
DB_PASSWORD=
DB_NAME=quantumcart_inventory
DB_CONNECTION_LIMIT=10

# RabbitMQ (required by app)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_EXCHANGE=quantumcart.events

# Optional (for local tooling/compose)
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672